{
  "name": "skill-sync-ai",
  "version": "1.0.0",
  "description": "SkillSync AI - Autonomous Multi-Agent Personalized Learning & Career Guidance Platform",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "rundev": "npm --prefix frontend run dev",
    "install:frontend": "cd frontend && npm install --legacy-peer-deps",
    "build": "cd frontend && npm install --legacy-peer-deps && npm run build",
    "preview": "npm --prefix frontend run preview",
    "server": "python -m uvicorn backend.main:app --reload --port 8000"
  },
  "keywords": [
    "ai",
    "multi-agent",
    "personalized-learning",
    "career-guidance",
    "react",
    "fastapi",
    "tailwind"
  ]
}
